POSTGRES_HOST=localhost
POSTGRES_DB=nutricion
POSTGRES_USER=nutricion
POSTGRES_PASSWORD=nutricion
POSTGRES_PORT=5432

# Ruta absoluta en el host al archivo .credentials.json de la suscripción de
# Claude Code (normalmente en C:\Users\<usuario>\.claude\.credentials.json en
# Windows, o ~/.claude/.credentials.json en Linux/Mac). Se monta como volumen
# de solo lectura dentro del contenedor `app` para que el Agent SDK pueda
# autenticarse. No pongas aquí un valor real, solo en tu .env local (que no
# se versiona).
CLAUDE_CREDENTIALS_PATH=
